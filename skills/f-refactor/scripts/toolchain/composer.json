{
    "name": "f-refactor/toolchain",
    "description": "Isolated PHP analysis tools for f-refactor. Not an application dependency.",
    "type": "project",
    "require": {
        "php": ">=8.4.3",
        "deptrac/deptrac": "^4.0",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "squizlabs/php_codesniffer": "^3.13",
        "vimeo/psalm": "^6.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": false,
        "audit": {
            "abandoned": "report"
        },
        "disable-tls": false,
        "platform": {
            "php": "8.4.3"
        },
        "secure-http": true,
        "sort-packages": true
    }
}
